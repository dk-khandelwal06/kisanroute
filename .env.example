# =============================================================================
# KisanRoute Environment Configuration
# =============================================================================

# Frontend (Publicly exposed in client bundle - NEVER put secret API keys here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production example: NEXT_PUBLIC_API_BASE_URL=https://kisanroute-api.onrender.com

# Backend (Server-Side Only - Private)
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kisanroute.vercel.app
MODEL_PATH=ml/models/best_model_pipeline.joblib
METRICS_PATH=ml/evaluation_metrics.json
METADATA_PATH=ml/model_metadata.json

# Optional Gemini API Key (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CONFIDENCE_THRESHOLD=0.35

